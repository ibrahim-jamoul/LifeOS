NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — required only for the secured cross-user cron materializer.
# Prefer the current Supabase secret key. The legacy service-role JWT is also
# accepted during migration, but never expose either variable to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI provider. App must work without these.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Optional cron protection when using a Vercel route.
CRON_SECRET=

# Optional email notifications, not required for core LifeOS.
EMAIL_PROVIDER_API_KEY=

# Test-only accounts. Use dedicated disposable users, never personal production accounts.
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
LIFEOS_E2E_EMAIL=
LIFEOS_E2E_PASSWORD=
PLAYWRIGHT_BASE_URL=
